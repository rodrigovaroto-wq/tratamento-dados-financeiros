      "id": "ibge-sidra-ipca-",
      "name": "IBGE SIDRA (IPCA)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        380
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { __serie: 'IPCA', __fonte: 'IBGE/SIDRA', __corpo: $input.all().map(i => i.json) } }];"
      },
      "id": "marcar-fonte-ibge",
      "name": "Marcar Fonte IBGE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const SERIES = [{\"codigo\":\"IPCA\",\"sgs\":433},{\"codigo\":\"IGPM\",\"sgs\":189},{\"codigo\":\"INPC\",\"sgs\":188},{\"codigo\":\"SELIC\",\"sgs\":4390},{\"codigo\":\"CDI\",\"sgs\":4391},{\"codigo\":\"CAMBIO_USD\",\"sgs\":1}];\nfunction num(b){ if(typeof b==='number') return isFinite(b)?b:null;\n  const t=String(b==null?'':b).trim(); if(!t) return null;\n  const n=Number(t.includes(',')?t.replace(/\\./g,'').replace(',','.'):t); return isFinite(n)?n:null; }\nfunction dataSgs(b){ const m=String(b==null?'':b).match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n  return m? m[3]+'-'+m[2]+'-'+m[1] : null; }\nconst obs=[];\nfor (const item of $input.all()) {\n  const j=item.json||{};\n  const serie=j.__serie, corpo=j.__corpo;\n  if(!serie||!Array.isArray(corpo)) continue;\n  if(j.__fonte==='IBGE/SIDRA'){\n    for(const o of corpo.slice(1)){\n      const m=String(o&&o.D3C||'').match(/^(\\d{4})(\\d{2})$/);\n      const v=num(o&&o.V);\n      if(m&&v!==null) obs.push({serie:'IPCA',fonte:'IBGE/SIDRA',data_ref:m[1]+'-'+m[2]+'-01',valor:v});\n    }\n  } else {\n    for(const o of corpo){\n      const d=dataSgs(o&&o.data), v=num(o&&o.valor);\n      if(d&&v!==null) obs.push({serie:serie,fonte:'BCB/SGS',data_ref:d,valor:v});\n    }\n  }\n}\nreturn [{ json: { observacoes: obs, n: obs.length } }];"
      },
