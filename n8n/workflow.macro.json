      "id": "manter-contexto-focus",
      "name": "Manter Contexto Focus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "const obs=[];\nfor (const item of $input.all()) {\n  const j=item.json||{};\n  const serie=j.__serie;\n  const linhas=(j.__corpo&&j.__corpo.value)||[];\n  if(!serie||linhas.length===0) continue;\n  // Só a coleta MAIS RECENTE: a API devolve o histórico inteiro de boletins e\n  // misturar duas semanas daria dois números para o mesmo ano.\n  let recente=''; for(const l of linhas){ if(l&&l.Data>recente) recente=l.Data; }\n  const vistos={};\n  for(const l of linhas){\n    if(!l||l.Data!==recente) continue;\n    const ano=Number(l.DataReferencia);\n    const mediana=typeof l.Mediana==='number'?l.Mediana:null;\n    if(!Number.isInteger(ano)||mediana===null||vistos[ano]) continue;\n    vistos[ano]=1;\n    obs.push({serie:serie,ano_ref:ano,mediana:mediana,\n      media:typeof l.Media==='number'?l.Media:null,\n      respondentes:typeof l.numeroRespondentes==='number'?l.numeroRespondentes:null,\n      coletado_em:recente});\n  }\n}\nreturn [{ json: { expectativas: obs, n: obs.length } }];"
      },
      "id": "normalizar-focus",
      "name": "Normalizar Focus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        560
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_registrar_expectativa_macro($1::jsonb) as n",
        "options": {
