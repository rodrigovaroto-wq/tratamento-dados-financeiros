        "jsCode": "return [{\"json\":{\"__serie\":\"IPCA\",\"__url\":\"https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata/ExpectativasMercadoAnuais?$top=80&$format=json&$orderby=Data%20desc&$filter=Indicador%20eq%20'IPCA'\"}},{\"json\":{\"__serie\":\"SELIC\",\"__url\":\"https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata/ExpectativasMercadoAnuais?$top=80&$format=json&$orderby=Data%20desc&$filter=Indicador%20eq%20'Selic'\"}},{\"json\":{\"__serie\":\"IGPM\",\"__url\":\"https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata/ExpectativasMercadoAnuais?$top=80&$format=json&$orderby=Data%20desc&$filter=Indicador%20eq%20'IGP-M'\"}},{\"json\":{\"__serie\":\"PIB\",\"__url\":\"https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata/ExpectativasMercadoAnuais?$top=80&$format=json&$orderby=Data%20desc&$filter=Indicador%20eq%20'PIB%20Total'\"}},{\"json\":{\"__serie\":\"CAMBIO_USD\",\"__url\":\"https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata/ExpectativasMercadoAnuais?$top=80&$format=json&$orderby=Data%20desc&$filter=Indicador%20eq%20'C%C3%A2mbio'\"}}];"
      },
